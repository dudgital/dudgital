{
  "name": "@dudgital/dude",
  "version": "0.1.0",
  "description": "Dudgital CLI — developer automation (dude / dg)",
  "type": "module",
  "bin": {
    "dude": "./dist/bin.js",
    "dg": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "node ../scripts/check-publishable.mjs",
    "prepublishOnly": "pnpm run build && pnpm run pack:check"
  },
  "devDependencies": {
    "@dudgital/framework-laravel": "workspace:*",
    "@dudgital/framework-nextjs": "workspace:*",
    "@dudgital/module-auth": "workspace:*",
    "@dudgital/module-notify": "workspace:*",
    "@dudgital/operations": "workspace:*",
    "@dudgital/provider-better-auth": "workspace:*",
    "@dudgital/provider-clerk": "workspace:*",
    "@dudgital/provider-resend": "workspace:*",
    "@dudgital/shared": "workspace:*",
    "tsup": "^8.5.1"
  }
}
